    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_label"
          }
        }
      },
      "then": {
        "properties": {
          "columns": {
            "maxItems": 0
          },
          "warnings": {
