          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "per_100g"
                }
              }
            },
            "then": {
              "properties": {
                "basis_amount": {
                  "const": 100
                },
                "basis_unit": {
                  "const": "g"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "per_100ml"
                }
              }
            },
            "then": {
              "properties": {
                "basis_amount": {
                  "const": 100
                },
                "basis_unit": {
                  "const": "ml"
                }
              }
            }
          }
        ]
