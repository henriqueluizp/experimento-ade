        "required": [
          "id",
          "basis_amount",
          "basis_unit",
          "nutrients"
        ],
        "properties": {
          "id": {
            "enum": [
              "per_serving",
              "per_100g",
              "per_100ml"
            ]
          },
          "basis_amount": {
            "type": [
              "number",
              "null"
            ],
