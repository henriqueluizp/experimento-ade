  "additionalProperties": false,
  "required": [
    "status",
    "product_name",
    "columns",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "review_required",
        "not_label"
      ]
    },
    "product_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "columns": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
