          "basis_unit": {
            "enum": [
              "g",
              "ml",
              null
            ]
          },
          "nutrients": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "energy_kcal",
              "energy_kj",
              "carbohydrates",
              "total_sugars",
              "added_sugars",
              "protein",
              "total_fat",
              "saturated_fat",
              "trans_fat",
              "fiber",
              "sodium"
            ],
            "properties": {
              "energy_kcal": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "unit",
                      "qualifier",
                      "raw"
                    ],
                    "properties": {
                      "value": {
                        "type": "number",
