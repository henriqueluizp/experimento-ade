{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NutritionExtraction",
  "description": "Extracao bruta: somente colunas impressas. IDs de coluna unicos; validar unicidade no servidor. Ausente e null, zero explicito e 0.",
